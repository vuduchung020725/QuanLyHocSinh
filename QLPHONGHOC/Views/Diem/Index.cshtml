@model QLPhongHoc.Models.PagedResult<QLPhongHoc.Models.DiemDto>
@{
    ViewData["Title"] = "Quản lý Điểm số & Sổ điểm";
    var lops = ViewData["Lops"] as List<QLPhongHoc.Models.LopDto> ?? new();
    var monHocs = ViewData["MonHocs"] as List<QLPhongHoc.Models.MonHocDto> ?? new();
    var hocKys = ViewData["HocKys"] as List<QLPhongHoc.Models.HocKyDto> ?? new();
    var currentLop = ViewData["CurrentLop"] as int?;
    var currentHocKy = ViewData["CurrentHocKy"] as int?;
    var isTeacherOrAdmin = User.IsInRole("ADMIN") || User.IsInRole("TEACHER");
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1 text-primary fw-bold">Quản lý Điểm số & Sổ điểm</h2>
            <p class="text-muted mb-0">Theo dõi điểm thành phần, tự động tính ĐTB môn theo chuẩn Bộ GD và gửi Zalo tới phụ huynh</p>
        </div>
        <div class="d-flex gap-2">
            @if (isTeacherOrAdmin)
            {
                <button type="button" class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#exportExcelModal">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Xuất Bảng Điểm Excel (.xlsx)
                </button>
                <a class="btn btn-primary d-flex align-items-center gap-1" href="@Url.Action("Create","Diem")">
                    <span>+</span> Nhập điểm mới
                </a>
            }
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Lớp học</label>
                    <select name="maLop" class="form-select">
                        <option value="">-- Tất cả lớp --</option>
                        @foreach(var l in lops)
                        {
                            <option value="@l.MaLop" selected="@(currentLop == l.MaLop)">@l.TenLop</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Học kỳ</label>
                    <select name="maHocKy" class="form-select">
                        <option value="">-- Tất cả học kỳ --</option>
                        @foreach(var hk in hocKys)
                        {
                            <option value="@hk.MaHocKy" selected="@(currentHocKy == hk.MaHocKy)">@hk.TenHocKy</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Môn học</label>
                    <select name="maMonHoc" class="form-select">
                        <option value="">-- Tất cả môn học --</option>
                        @foreach(var m in monHocs)
                        {
                            <option value="@m.MaMonHoc">@m.TenMon</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 me-2">Lọc</button>
                    <a href="@Url.Action("Index","Diem")" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng điểm chi tiết -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Học sinh</th>
                        <th>Lớp</th>
                        <th>Môn</th>
                        <th>Học kỳ</th>
                        <th class="text-center">Miệng (x1)</th>
                        <th class="text-center">15 Phút (x1)</th>
                        <th class="text-center">Giữa Kỳ (x2)</th>
                        <th class="text-center">Cuối Kỳ (x3)</th>
                        <th class="text-center text-primary">ĐTB Môn</th>
                        <th class="text-center">Xếp loại</th>
                        @if (isTeacherOrAdmin)
                        {
                            <th class="text-end pe-3">Tương tác Phụ huynh</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 text-muted">Chưa có dữ liệu điểm phù hợp với bộ lọc.</td>
                    </tr>
                }
                @foreach(var it in Model.Items)
                {
                    <tr>
                        <td class="ps-3">
                            <span class="fw-bold text-dark">@it.TenHocSinh</span>
                            <div class="small text-muted">@it.MaHS</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@it.TenLop</span></td>
                        <td class="fw-semibold">@it.TenMon</td>
                        <td><span class="small text-muted">@it.TenHocKy</span></td>
                        <td class="text-center">@(it.DiemMieng?.ToString("0.0") ?? "-")</td>
                        <td class="text-center">@(it.Diem15Phut?.ToString("0.0") ?? "-")</td>
                        <td class="text-center">@(it.DiemGiuaKy?.ToString("0.0") ?? "-")</td>
                        <td class="text-center">@(it.DiemCuoiKy?.ToString("0.0") ?? "-")</td>
                        <td class="text-center">
                            @if (it.DiemTrungBinh.HasValue)
                            {
                                <span class="fw-bold fs-6 text-primary">@it.DiemTrungBinh.Value.ToString("0.00")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(it.XepLoai))
                            {
                                @if (it.XepLoai == "Giỏi")
                                {
                                    <span class="badge bg-success">Giỏi</span>
                                }
                                else if (it.XepLoai == "Khá")
                                {
                                    <span class="badge bg-info text-dark">Khá</span>
                                }
                                else if (it.XepLoai == "Trung bình")
                                {
                                    <span class="badge bg-secondary">Trung bình</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@it.XepLoai</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Chưa đủ điểm</span>
                            }
                        </td>
                        @if (isTeacherOrAdmin)
                        {
                            <td class="text-end pe-3">
                                <form method="post" action="@Url.Action("SendZaloBangDiem", "Diem", new { maHocSinh = it.MaHocSinh, maHocKy = it.MaHocKy })" style="display:inline;" onsubmit="return confirm('Gửi bảng điểm qua tin nhắn Zalo ZNS cho phụ huynh em @it.TenHocSinh?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" title="Gửi tin nhắn Zalo ZNS cho phụ huynh">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                        </svg>
                                        Gửi Zalo
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Xuất Bảng Điểm Excel -->
<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-labelledby="exportExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="exportExcelModalLabel">Xuất Bảng Điểm Excel (.xlsx)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="get" action="@Url.Action("ExportExcel", "Diem")">
                <div class="modal-body">
                    <p class="text-muted small mb-3">Chọn Lớp học và Học kỳ để trích xuất file Excel bảng điểm tổng kết (chuẩn định dạng giáo vụ, font Inter, màu Navy #1B365D).</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Lớp học</label>
                        <select name="maLop" class="form-select" required>
                            @foreach(var l in lops)
                            {
                                <option value="@l.MaLop">@l.TenLop</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Học kỳ</label>
                        <select name="maHocKy" class="form-select" required>
                            @foreach(var hk in hocKys)
                            {
                                <option value="@hk.MaHocKy">@hk.TenHocKy</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">
                        Tải file Excel (.xlsx)
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
