@model QLPhongHoc.Models.UpdateHocSinhRequest
@{
    ViewData["Title"] = "Sửa học sinh";
    var lops = ViewData["Lops"] as List<QLPhongHoc.Models.LopDto> ?? new();
    var id = ViewData["MaHocSinh"] as int? ?? 0;
}

<h2>Sửa học sinh</h2>

<form method="post" asp-action="Edit" asp-route-id="@id">
    <div class="mb-3">
        <label class="form-label">Mã HS</label>
        <input asp-for="MaHS" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="HoTen" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Ngày sinh</label>
        <input asp-for="NgaySinh" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Giới tính</label>
        <input asp-for="GioiTinh" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tên phụ huynh</label>
        <input asp-for="TenPhuHuynh" class="form-control" placeholder="Họ tên phụ huynh / người giám hộ" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số điện thoại phụ huynh (Zalo)</label>
        <input asp-for="SdtPhuHuynh" class="form-control" placeholder="Số điện thoại nhận tin nhắn ZNS" />
    </div>
    <div class="mb-3">
        <label class="form-label">Lớp</label>
        <select asp-for="MaLop" class="form-control">
            <option value="">-- Chọn lớp --</option>
            @foreach(var l in lops)
            {
                if (Model.MaLop == l.MaLop)
                {
                    <option value="@l.MaLop" selected>@l.TenLop</option>
                }
                else
                {
                    <option value="@l.MaLop">@l.TenLop</option>
                }
            }
        </select>
    </div>
    <button class="btn btn-primary" type="submit">Lưu</button>
    <a class="btn btn-secondary" href="@Url.Action("Index","HocSinh")">Hủy</a>
</form>
