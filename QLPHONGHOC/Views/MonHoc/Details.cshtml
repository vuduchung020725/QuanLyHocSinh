@model QLPhongHoc.Models.MonHocDto
@{
    ViewData["Title"] = "Chi tiết môn học";
}

<h2>Chi tiết môn học</h2>

<dl class="row">
    <dt class="col-sm-3">Mã môn</dt>
    <dd class="col-sm-9">@Model.MaMon</dd>

    <dt class="col-sm-3">Tên môn</dt>
    <dd class="col-sm-9">@Model.TenMon</dd>

    <dt class="col-sm-3">Số tiết</dt>
    <dd class="col-sm-9">@Model.SoTiet</dd>
</dl>

<a class="btn btn-secondary" href="@Url.Action("Index","MonHoc")">Quay lại</a>
